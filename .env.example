# Pick ONE provider block below. This submission was measured with Gemini.

# --- Google Gemini (free tier: aistudio.google.com/apikey) ---
# OPENAI_API_KEY=AQ....            # or AIza... — an AI Studio key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEN_MODEL=gemini-3.1-flash-lite
# FAST_MODEL=gemini-3.1-flash-lite

# --- Groq (free tier: console.groq.com; defaults in config.py) ---
GROQ_API_KEY=

# ---- optional overrides (defaults shown) ----
# LLM_BASE_URL=https://api.groq.com/openai/v1
# GEN_MODEL=llama-3.3-70b-versatile
# FAST_MODEL=llama-3.1-8b-instant
# EMBED_MODEL=intfloat/multilingual-e5-small
# TOP_K=15
# LLM_TIMEOUT=25
# USD_INR=86

# To use OpenAI (or any OpenAI-compatible provider) instead of Groq:
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# GEN_MODEL=gpt-4o-mini
# FAST_MODEL=gpt-4o-mini

# NVIDIA NIM example:
# OPENAI_API_KEY=nvapi-...
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# GEN_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# FAST_MODEL=meta/llama-3.1-8b-instruct
# GEN_SYSTEM_PREFIX=/no_think    # disables Nemotron reasoning tokens

# OPTIONAL automatic failover — if the primary provider rate-limits or dies,
# calls transparently retry on this one:
# FALLBACK_API_KEY=nvapi-...
# FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# FALLBACK_GEN_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# FALLBACK_FAST_MODEL=meta/llama-3.1-8b-instruct
# FALLBACK_GEN_SYSTEM_PREFIX=/no_think

# Only for the OPTIONAL demo UI's "answer from web" button (never used by the
# graded pipeline): https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
